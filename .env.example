# RegLens defaults to deterministic fake mode.
REGLENS_APP_NAME=RegLens
REGLENS_APP_ENV=local
REGLENS_APP_VERSION=0.1.0
# Use mock for deterministic no-network runs. Use local for Qdrant-backed
# retrieval after installing the qdrant extra and starting Qdrant.
REGLENS_RAG_MODE=mock
REGLENS_LOG_LEVEL=INFO

REGLENS_DATABASE_URL=sqlite:///./reglens.db
REGLENS_DOCUMENT_STORAGE_PATH=./data/raw

REGLENS_QDRANT_URL=http://localhost:6333
REGLENS_QDRANT_COLLECTION=regulatory_chunks

REGLENS_USE_FAKE_EMBEDDINGS=true
REGLENS_USE_FAKE_LLM=true
REGLENS_USE_FAKE_RERANKER=true
REGLENS_EMBEDDING_PROVIDER=fake
REGLENS_LLM_PROVIDER=fake
REGLENS_RERANKER_PROVIDER=fake

REGLENS_MAX_QUERY_CHARS=2000
REGLENS_DEFAULT_TOP_K=8
REGLENS_MAX_EVIDENCE_TOKENS=6000
REGLENS_ENABLE_HASH_CHAIN_AUDIT=true
REGLENS_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
REGLENS_REQUEST_ID_HEADER=X-Request-ID
REGLENS_ALLOWED_INGEST_URL_HOSTS=finra.org,www.finra.org,rules.finra.org
REGLENS_REMOTE_INGEST_MAX_BYTES=5000000
REGLENS_ENABLE_EMBEDDING_CACHE=true
REGLENS_EMBEDDING_CACHE_MAX_ENTRIES=10000

# Optional API hardening. Leave empty/zero for open local development.
REGLENS_API_KEY=
REGLENS_API_KEY_HEADER=X-RegLens-API-Key
REGLENS_AUTH_EXEMPT_PATHS=/,/health,/ready,/docs,/openapi.json
REGLENS_RATE_LIMIT_PER_MINUTE=0

# Optional later. Do not set for fake-mode tests.
OPENAI_API_KEY=
REGLENS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REGLENS_OPENAI_EMBEDDING_DIMENSIONS=1536
REGLENS_OPENAI_GENERATION_MODEL=gpt-5.4-nano
REGLENS_OPENAI_GENERATION_MAX_OUTPUT_TOKENS=400
REGLENS_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
REGLENS_CROSS_ENCODER_BATCH_SIZE=16
REGLENS_CROSS_ENCODER_MAX_LENGTH=
REGLENS_CROSS_ENCODER_DEVICE=
REGLENS_CROSS_ENCODER_CACHE_FOLDER=
REGLENS_CROSS_ENCODER_LOCAL_FILES_ONLY=false
REGLENS_CROSS_ENCODER_TRUST_REMOTE_CODE=false
